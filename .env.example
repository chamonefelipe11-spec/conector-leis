# Copie para .env e troque o TOKEN. Gere um com:  openssl rand -hex 24
# O token vira parte do endereço do conector: quem não souber, não acessa.
TOKEN=troque-por-um-token-aleatorio-de-48-caracteres

# Horário da atualização diária do acervo (git pull + reindexação do que mudou)
HORA_ATUALIZACAO=04:30

PORTA=8787
